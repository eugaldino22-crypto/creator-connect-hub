# Video calling — configure ONLY in Supabase Edge Function secrets / deployment environment.
# Never expose the API secret in browser code and never commit real credentials.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Payment provider credentials must be configured only in the deployment environment.
# Never commit NOWPayments keys, webhook secrets, service-role keys, or other secrets.
